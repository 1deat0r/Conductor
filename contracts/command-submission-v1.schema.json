{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.conductor.invalid/command-submission-v1.schema.json",
  "title": "CommandSubmissionV1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "$ref": "#/$defs/id"
    },
    "deadline_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "target": {
      "$ref": "#/$defs/submissionTarget"
    },
    "revision_target": {
      "$ref": "#/$defs/revisionTarget"
    },
    "action": {
      "$ref": "#/$defs/CommandActionV1"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "deadline_unix_ms",
    "action"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "submissionTarget": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "attempt_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    },
    "revisionTarget": {
      "type": "object",
      "properties": {
        "aggregate_kind": {
          "enum": [
            "task",
            "attempt"
          ]
        },
        "aggregate_id": {
          "$ref": "#/$defs/id"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "aggregate_kind",
        "aggregate_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "TaskCreate": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task.create"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "kind",
        "title",
        "goal"
      ],
      "additionalProperties": false
    },
    "TaskUpdate": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task.update"
        },
        "changes": {
          "$ref": "#/$defs/TaskChanges"
        }
      },
      "required": [
        "kind",
        "changes"
      ],
      "additionalProperties": false
    },
    "TaskChanges": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "AttemptStart": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "attempt.start"
        },
        "launch_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "launch_digest"
      ],
      "additionalProperties": false
    },
    "AttemptCancel": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "attempt.cancel"
        },
        "reason": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "CommandActionV1": {
      "oneOf": [
        {
          "$ref": "#/$defs/TaskCreate"
        },
        {
          "$ref": "#/$defs/TaskUpdate"
        },
        {
          "$ref": "#/$defs/AttemptStart"
        },
        {
          "$ref": "#/$defs/AttemptCancel"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "properties": {
              "kind": {
                "const": "task.create"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "target"
              ],
              "type": "object"
            },
            {
              "required": [
                "revision_target"
              ],
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "properties": {
              "kind": {
                "const": "task.update"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "target",
          "revision_target"
        ],
        "properties": {
          "target": {
            "not": {
              "required": [
                "attempt_id"
              ],
              "type": "object"
            }
          },
          "revision_target": {
            "properties": {
              "aggregate_kind": {
                "const": "task"
              }
            },
            "required": [
              "aggregate_kind"
            ],
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "properties": {
              "kind": {
                "const": "attempt.start"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "target",
          "revision_target"
        ],
        "properties": {
          "target": {
            "not": {
              "required": [
                "attempt_id"
              ],
              "type": "object"
            }
          },
          "revision_target": {
            "properties": {
              "aggregate_kind": {
                "const": "task"
              }
            },
            "required": [
              "aggregate_kind"
            ],
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "properties": {
              "kind": {
                "const": "attempt.cancel"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "target",
          "revision_target"
        ],
        "properties": {
          "target": {
            "required": [
              "task_id",
              "attempt_id"
            ],
            "type": "object"
          },
          "revision_target": {
            "properties": {
              "aggregate_kind": {
                "const": "attempt"
              }
            },
            "required": [
              "aggregate_kind"
            ],
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
