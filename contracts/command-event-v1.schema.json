{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.conductor.invalid/command-event-v1.schema.json",
  "title": "CommandEventV1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "$ref": "#/$defs/id"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "event_class": {
      "enum": [
        "required",
        "informational"
      ]
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "task",
            "attempt",
            "session"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "id",
        "sequence"
      ],
      "additionalProperties": false
    },
    "command_id": {
      "$ref": "#/$defs/id"
    },
    "causation_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_id": {
      "$ref": "#/$defs/id"
    },
    "ownership_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "occurred_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "snapshot_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "event_class",
    "aggregate",
    "command_id",
    "causation_id",
    "actor_id",
    "ownership_generation",
    "occurred_at_unix_ms",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "AttemptState": {
      "enum": [
        "queued",
        "provisioning",
        "running",
        "waiting_for_input",
        "waiting_for_approval",
        "validating",
        "review_ready",
        "completed",
        "failed",
        "cancelled",
        "interrupted",
        "outcome_unknown"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.created"
          }
        },
        "required": [
          "event_type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "event_class": {
            "const": "required"
          },
          "aggregate": {
            "properties": {
              "kind": {
                "const": "task"
              }
            },
            "type": "object"
          },
          "payload": {
            "type": "object",
            "properties": {
              "task_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "task_revision"
            ],
            "additionalProperties": false
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.updated"
          }
        },
        "required": [
          "event_type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "event_class": {
            "const": "required"
          },
          "aggregate": {
            "properties": {
              "kind": {
                "const": "task"
              }
            },
            "type": "object"
          },
          "payload": {
            "type": "object",
            "properties": {
              "task_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "task_revision"
            ],
            "additionalProperties": false
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "attempt.state_changed"
          }
        },
        "required": [
          "event_type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "event_class": {
            "const": "required"
          },
          "aggregate": {
            "properties": {
              "kind": {
                "const": "attempt"
              }
            },
            "type": "object"
          },
          "payload": {
            "type": "object",
            "properties": {
              "from": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/AttemptState"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to": {
                "$ref": "#/$defs/AttemptState"
              }
            },
            "required": [
              "to"
            ],
            "additionalProperties": false
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "not": {
              "enum": [
                "task.created",
                "task.updated",
                "attempt.state_changed"
              ]
            }
          }
        },
        "required": [
          "event_type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "event_class": {
            "const": "informational"
          }
        },
        "required": [
          "snapshot_cursor"
        ],
        "type": "object"
      }
    }
  ]
}
