{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://conductor.invalid/contracts/health-v1.schema.json",
  "title": "HealthV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service",
    "status",
    "execution_available"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "service": {
      "enum": [
        "control-api",
        "host",
        "supervisor"
      ]
    },
    "status": {
      "const": "scaffold"
    },
    "execution_available": {
      "const": false
    }
  }
}
